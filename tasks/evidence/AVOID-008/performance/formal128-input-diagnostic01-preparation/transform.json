  "oldHash": "hash=async value=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(JSON.stringify(value))))).map(x=>x.toString(16).padStart(2,'0')).join('')",
  "newHash": "hash=async (value,observation=null)=>{const text=JSON.stringify(value);if(observation)window.CPerfNormalizedEvidence.push({...observation,preHashJSON:text});const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(text)))).map(x=>x.toString(16).padStart(2,'0')).join('');if(observation)window.CPerfNormalizedEvidence.at(-1).preHashSHA256=digest;return digest;}",

  "newPoint": "inputSHA256=await hash(source,{iteration:i,n,on,side,warmup:i<config.planningWarmup}),sourceJSON=JSON.stringify(source);window.CPerfNormalizedEvidence.at(-1).postHashJSON=sourceJSON;",

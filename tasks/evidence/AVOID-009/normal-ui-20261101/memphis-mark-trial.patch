+// A cheap sufficient proof that native clearOf is always zero. Bound each
+// affine coordinate over the whole independent bbox-edge box, without using
+// the branch LP result. Clamp is monotone on the admitted viewport domain.
+function alwaysHiddenByBBox(bounds,position,W,H,S) {
+  const pad=S*1.3,edge=S*1.6;
+  if(!(Number.isFinite(pad)&&Number.isFinite(edge)&&W>=2*edge&&H>=2*edge))return false;
+  let magnitude=1+Math.abs(W)+Math.abs(H)+Math.abs(S)+bounds.reduce((n,r)=>n+Math.max(Math.abs(r[0]),Math.abs(r[1])),0);
+  const limits=position.map(expr=>{
+    let lo=expr[0],hi=expr[0];magnitude+=Math.abs(expr[0]);
+    for(let i=0;i<bounds.length;i++){
+      const x=expr[i+1]*bounds[i][0],y=expr[i+1]*bounds[i][1];
+      lo+=Math.min(x,y);hi+=Math.max(x,y);
+      magnitude+=Math.abs(expr[i+1])*Math.max(Math.abs(bounds[i][0]),Math.abs(bounds[i][1]));
+    }
+    return [lo,hi];
+  });
+  // Cover arithmetic in the native perimeter expression, affine expansion,
+  // interval sums and comparison, including the viewport dimensions.
+  const guard=.5+1024*Number.EPSILON*magnitude;
+  if(!Number.isFinite(guard)||!limits.flat().every(Number.isFinite))return false;
+  const x=limits[0].map(v=>clamp(v,edge,W-edge)),y=limits[1].map(v=>clamp(v,edge,H-edge));
+  return x[0]>=bounds[0][1]-pad+guard&&x[1]<=bounds[1][0]+pad-guard&&
+         y[0]>=bounds[2][1]-pad+guard&&y[1]<=bounds[3][0]+pad-guard;
+}
